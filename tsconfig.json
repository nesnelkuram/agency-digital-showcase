{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2020",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "node",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "allowJs": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./*"],
      "@admin/*": ["admin/*"],
      "@lib/*": ["lib/*"],
      "@shared/*": ["shared/*"],
      "@contexts/*": ["contexts/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "admin/**/*.ts",
    "admin/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "contexts/**/*.ts",
    "contexts/**/*.tsx",
    "portal/**/*.ts",
    "portal/**/*.tsx",
    "vite-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "api"],
  "ts-node": {
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
    "esm": true,
    "ignore": ["node_modules", "\\.mjs$"]
  }
}
