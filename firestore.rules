rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // Helper functions for multi-tenant isolation
    // =============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserTenantId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Kullanıcının atanmış projeleri (proje kapsamlı roller için)
    function getAssignedProjectIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profile', {}).get('assignedProjectIds', []);
    }

    // İç ekip rolleri: tenant genelindeki verilere erişir.
    // client ve brand_manager bu kümede DEĞİL — yalnızca açıkça tanımlı, proje kapsamlı kurallardan geçer.
    function isInternal() {
      return isAuthenticated()
        && getUserRole() in ['super_admin', 'admin', 'account_manager', 'staff', 'editor', 'freelancer'];
    }

    function isBrandManager() {
      return isAuthenticated() && getUserRole() == 'brand_manager';
    }

    // Proje verisinde (projects, content_plans, social_media_posts) tenant genelinde erişen roller.
    // freelancer ve brand_manager proje verisine yalnızca atanmış projelerden erişir.
    function hasTenantWideProjectAccess(tenantId) {
      return isAuthenticated()
        && getUserRole() in ['super_admin', 'admin', 'account_manager', 'staff', 'editor']
        && tenantId == getUserTenantId();
    }

    function belongsToTenant() {
      return isInternal() && resource.data.tenantId == getUserTenantId();
    }

    function creatingForOwnTenant() {
      return isInternal() && request.resource.data.tenantId == getUserTenantId();
    }

    // Proje kapsamlı roller (marka yöneticisi, freelancer): aynı tenant + atanmış proje
    function brandManagerOwnsProject(tenantId, projectId) {
      return isAuthenticated()
        && getUserRole() in ['brand_manager', 'freelancer']
        && tenantId == getUserTenantId()
        && projectId in getAssignedProjectIds();
    }

    // Post'un bağlandığı plan (varsa) aynı tenant ve projeye ait olmalı
    function validPlanLink(data) {
      return data.get('contentPlanId', null) == null
        || (exists(/databases/$(database)/documents/content_plans/$(data.contentPlanId))
            && get(/databases/$(database)/documents/content_plans/$(data.contentPlanId)).data.tenantId == data.tenantId
            && get(/databases/$(database)/documents/content_plans/$(data.contentPlanId)).data.projectId == data.get('projectId', null));
    }

    // Belirtilen alanlar dışında değişiklik yok
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Kimlik alanları değişmiyor (kayıt başka tenant/projeye taşınamaz)
    function keepsIdentity() {
      return request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.get('projectId', null) == resource.data.get('projectId', null);
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || getUserRole() == 'super_admin');
    }

    function isAccountManager() {
      return isAuthenticated() && getUserRole() == 'account_manager';
    }

    function isClient() {
      return isAuthenticated() && getUserRole() == 'client';
    }

    // Can access pricing catalog prices (but NOT cost/margin)
    function canViewPricing() {
      return isAdmin() || isAccountManager();
    }

    // Can access cost/margin data — admin only
    function canViewCost() {
      return isAdmin();
    }

    // =============================================
    // Homepage showcase videos — PUBLIC read (shown on the public homepage),
    // admin/AM/editor write. Not tenant-scoped (the public site has no tenant).
    // =============================================
    match /homepage_videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated()
        && getUserRole() in ['admin', 'super_admin', 'account_manager', 'editor'];
    }

    // =============================================
    // Tenant collection
    // =============================================
    match /tenants/{tenantId} {
      // Super admins can read all tenants
      // Regular users can only read their own tenant
      allow read: if isSuperAdmin() || (isAuthenticated() && getUserTenantId() == tenantId);
      // Only super admins can create/update/delete tenants
      allow write: if isSuperAdmin();
    }

    // =============================================
    // Users collection
    // =============================================
    match /users/{userId} {
      // Okuma: kendi kaydı; iç ekip aynı tenant'taki üyeleri (görev atama / üye seçimi)
      allow read: if isSuperAdmin()
                  || (isAuthenticated() && request.auth.uid == userId)
                  || belongsToTenant();
      // Kullanıcı kendi kaydında yalnızca zararsız alanları değiştirebilir.
      // Rol, tenant, izinler, durum ve proje atamaları kullanıcı tarafından değiştirilemez.
      allow update: if isSuperAdmin()
                    || (isAuthenticated() && request.auth.uid == userId
                        && onlyChanges(['displayName', 'photoURL', 'profile', 'settings', 'metadata'])
                        && request.resource.data.get('profile', {}).diff(resource.data.get('profile', {})).affectedKeys()
                             .hasOnly(['phone', 'title', 'department', 'timezone'])
                        && request.resource.data.get('metadata', {}).diff(resource.data.get('metadata', {})).affectedKeys()
                             .hasOnly(['lastLoginAt', 'updatedAt']))
                    || (isAdmin() && request.auth.uid != userId
                        && resource.data.tenantId == getUserTenantId()
                        && request.resource.data.tenantId == resource.data.tenantId
                        && request.resource.data.role != 'super_admin'
                        && resource.data.role != 'super_admin');
      // Kullanıcı kaydı oluşturma: yalnızca sunucu (davet kabulü, Admin SDK) veya super admin.
      allow create: if isSuperAdmin();
      allow delete: if isSuperAdmin()
                    || (isAdmin() && resource.data.tenantId == getUserTenantId() && resource.data.role != 'super_admin');
    }

    // =============================================
    // Invitations collection
    // =============================================
    match /invitations/{invitationId} {
      // Tekil okuma kimliksiz serbest (davet linki doğrulama; kimlik tahmin edilemez)
      allow get: if true;
      // Listeleme: yalnızca aynı tenant'ın yöneticisi
      allow list: if isSuperAdmin() || (isAdmin() && resource.data.tenantId == getUserTenantId());
      // Oluşturma/değiştirme: yalnızca yönetici, kendi tenant'ında, super_admin daveti hariç.
      // Kabul (status: accepted) yalnızca sunucuda (api/invitations/accept).
      allow create: if isSuperAdmin()
                    || (isAdmin() && request.resource.data.tenantId == getUserTenantId()
                        && request.resource.data.role != 'super_admin'
                        && request.resource.data.status == 'pending');
      allow update: if isSuperAdmin()
                    || (isAdmin() && resource.data.tenantId == getUserTenantId()
                        && request.resource.data.tenantId == resource.data.tenantId
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.email == resource.data.email
                        && request.resource.data.status in ['pending', 'cancelled']);
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.tenantId == getUserTenantId());
    }

    // =============================================
    // Brand leads: allow public creation (website wizard), tenant-isolated otherwise
    // =============================================
    match /brand_leads/{leadId} {
      // Anyone can create a new lead (website form submissions)
      allow create: if true;
      // Authenticated users in the same tenant can read; also allow public read for shareToken links
      allow read: if isSuperAdmin()
                  || belongsToTenant()
                  || resource.data.shareToken != null;
      // Only authenticated users in the same tenant can update/delete
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Projects — clients can read their own projects
    // =============================================
    match /projects/{projectId} {
      // Müşteri projeleri portal API'sinden (sunucu) okur; doğrudan okuma yok.
      // Marka yöneticisi yalnızca atanmış projesini okur.
      allow read: if isSuperAdmin()
                  || hasTenantWideProjectAccess(resource.data.tenantId)
                  || brandManagerOwnsProject(resource.data.tenantId, projectId);
      allow create: if isSuperAdmin() || hasTenantWideProjectAccess(request.resource.data.tenantId);
      allow update: if isSuperAdmin()
                    || (hasTenantWideProjectAccess(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId);
      allow delete: if isSuperAdmin() || hasTenantWideProjectAccess(resource.data.tenantId);
    }

    // =============================================
    // Asset locations — masaüstü uygulaması klasör⇄marka/proje eşlemeleri
    // =============================================
    match /asset_locations/{linkId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Drives — masaüstü uygulaması disk kaydı (etiket, UUID, durum)
    // =============================================
    match /drives/{driveId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Marketing campaigns
    // =============================================
    match /marketing_campaigns/{campaignId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Campaign proposals
    // =============================================
    match /campaign_proposals/{proposalId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Platform accounts
    // =============================================
    match /platform_accounts/{accountId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Performance data
    // =============================================
    match /performance_data/{dataId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Marketing optimizations
    // =============================================
    match /marketing_optimizations/{optimizationId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Campaign breakdowns
    // =============================================
    match /campaign_breakdowns/{breakdownId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Campaign AI analyses
    // =============================================
    match /campaign_ai_analyses/{analysisId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Feedback videos: tenant-isolated + public read when isPublic == true
    // =============================================
    match /feedback_videos/{videoId} {
      // Public can read if video is marked isPublic; otherwise tenant-only
      allow read: if isSuperAdmin()
                  || belongsToTenant()
                  || resource.data.isPublic == true;
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Feedback comments
    // =============================================
    match /feedback_comments/{commentId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Feedback reactions
    // =============================================
    match /feedback_reactions/{reactionId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Competitors
    // =============================================
    match /competitors/{competitorId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Competitor analyses
    // =============================================
    match /competitor_analyses/{analysisId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Marketing reports
    // =============================================
    match /marketing_reports/{reportId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // UTM links
    // =============================================
    match /utm_links/{linkId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Automation rules
    // =============================================
    match /automation_rules/{ruleId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Rule execution logs
    // =============================================
    match /rule_execution_logs/{logId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Campaign templates
    // =============================================
    match /campaign_templates/{templateId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // A/B tests
    // =============================================
    match /ab_tests/{testId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Marketing alerts
    // =============================================
    match /marketing_alerts/{alertId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Budget forecasts
    // =============================================
    match /budget_forecasts/{forecastId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Social media posts
    // =============================================
    match /social_media_posts/{postId} {
      // Durum ve onay alanları yalnızca sunucudan (api/content-approval) değişir.
      // Müşteriye gönderilmiş/onaylanmış içerik kilitli: yalnızca takvim yeri (scheduledAt, gridPosition) değişebilir.
      function isContentEditable() {
        return resource.data.status in ['draft', 'internal_review', 'revision_requested_internal', 'revision_requested'];
      }
      function validContentUpdate() {
        return keepsIdentity()
          && (!('contentPlanId' in request.resource.data.diff(resource.data).affectedKeys()) || validPlanLink(request.resource.data))
          && onlyChanges(['title', 'caption', 'hashtags', 'mediaUrls', 'media', 'aiGeneratedCaption', 'captionChatHistory', 'postType', 'platforms', 'tags', 'contentPlanId', 'gridPosition', 'scheduledAt', 'updatedAt'])
          && (isContentEditable() || onlyChanges(['gridPosition', 'scheduledAt', 'updatedAt']));
      }
      function validNewPost() {
        return request.resource.data.status == 'draft'
          && validPlanLink(request.resource.data)
          && !('approvedBy' in request.resource.data)
          && !('internalReviewedBy' in request.resource.data);
      }

      allow read: if isSuperAdmin()
                  || hasTenantWideProjectAccess(resource.data.tenantId)
                  || brandManagerOwnsProject(resource.data.tenantId, resource.data.projectId);
      allow create: if isSuperAdmin()
                    || (hasTenantWideProjectAccess(request.resource.data.tenantId) && validNewPost())
                    || (brandManagerOwnsProject(request.resource.data.tenantId, request.resource.data.projectId) && validNewPost());
      allow update: if isSuperAdmin()
                    || (hasTenantWideProjectAccess(resource.data.tenantId) && validContentUpdate())
                    || (brandManagerOwnsProject(resource.data.tenantId, resource.data.projectId) && validContentUpdate());
      allow delete: if isSuperAdmin()
                    || (hasTenantWideProjectAccess(resource.data.tenantId) && resource.data.status in ['draft', 'internal_review', 'revision_requested_internal'])
                    || (brandManagerOwnsProject(resource.data.tenantId, resource.data.projectId) && resource.data.status == 'draft');
    }

    // =============================================
    // Creatives
    // =============================================
    match /creatives/{creativeId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Approvals
    // =============================================
    match /approvals/{approvalId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Activity log
    // =============================================
    match /activityLog/{logId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Assets
    // =============================================
    match /assets/{assetId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Asset folders
    // =============================================
    match /assetFolders/{folderId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Pricing data (pricing/data/* subcollections)
    // pricing/data/serviceCatalog, staff, equipment,
    // overhead, software, marketing, personnel
    // pricing/config/cache/*, pricing/settings
    // Only admin/account_manager — no tenantId field here
    // =============================================
    match /pricing/{document=**} {
      allow read: if isSuperAdmin() || (isAuthenticated() && canViewPricing());
      allow write: if isSuperAdmin() || (isAuthenticated() && canViewCost());
    }

    // =============================================
    // Pricing: catalog, proposals, quotes
    // Only admin/account_manager can access pricing
    // Editor and client roles have NO access
    // =============================================
    match /pricing_services/{serviceId} {
      allow read: if isSuperAdmin() || (belongsToTenant() && canViewPricing());
      allow create: if isSuperAdmin() || (creatingForOwnTenant() && canViewCost());
      allow update, delete: if isSuperAdmin() || (belongsToTenant() && canViewCost());
    }

    match /pricing_proposals/{proposalId} {
      allow read: if isSuperAdmin() || (belongsToTenant() && canViewPricing());
      allow create: if isSuperAdmin() || (creatingForOwnTenant() && canViewPricing());
      allow update, delete: if isSuperAdmin() || (belongsToTenant() && canViewPricing());
    }

    // =============================================
    // Proposals (teklif belgesi) — public read via
    // shareToken for /teklif/:shareToken pages
    // =============================================
    match /proposals/{proposalId} {
      // Public access when explicitly shared; proposals have no tenantId field
      // so use role-based auth instead of belongsToTenant()
      allow read: if resource.data.shareToken != null
                  || isSuperAdmin()
                  || (isAuthenticated() && canViewPricing());
      allow create: if isSuperAdmin() || (isAuthenticated() && canViewPricing());
      allow update: if resource.data.shareToken != null
                    || isSuperAdmin()
                    || (isAuthenticated() && canViewPricing());
      allow delete: if isSuperAdmin() || (isAuthenticated() && canViewPricing());

      // Proposal activity log — append-only
      match /activity/{eventId} {
        allow read: if isSuperAdmin() || (isAuthenticated() && canViewPricing());
        allow create: if true; // Public share page can log 'viewed' events
        allow update, delete: if false;
      }
    }

    // =============================================
    // Invoices (Faturalar) — sadece admin oluşturur/yönetir.
    // Public read/update via shareToken (müşteri görüntüleme sayfası + viewedAt).
    // =============================================
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin()
                  || (belongsToTenant() && isAdmin())
                  || resource.data.shareToken != null;
      allow create: if isSuperAdmin() || (creatingForOwnTenant() && isAdmin());
      allow update: if isSuperAdmin()
                    || (belongsToTenant() && isAdmin())
                    || resource.data.shareToken != null; // public sayfa viewedAt günceller
      allow delete: if isSuperAdmin() || (belongsToTenant() && isAdmin());
    }

    match /pricing_quotes/{quoteId} {
      allow read: if isSuperAdmin() || (belongsToTenant() && canViewCost());
      allow create: if isSuperAdmin() || (creatingForOwnTenant() && canViewCost());
      allow update, delete: if isSuperAdmin() || (belongsToTenant() && canViewCost());
    }

    // =============================================
    // Content plans — public read via shareToken,
    // clients can read/update (for approvals)
    // =============================================
    match /content_plans/{planId} {
      // Paylaşım linki ve müşteri portalı sunucu API'sinden okur (token/erişim sunucuda doğrulanır).
      // Durum, onay ayarı, müşteri ataması, inceleme turu ve yorumlar yalnızca sunucudan değişir.
      function validNewPlan() {
        return request.resource.data.status == 'draft'
          && !('reviewRequestId' in request.resource.data)
          && !('approvedBy' in request.resource.data)
          && !('assignedClientId' in request.resource.data);
      }
      function validPlanUpdate() {
        return keepsIdentity()
          && onlyChanges(['title', 'description', 'postIds', 'weekStartDate', 'weekEndDate', 'updatedAt']);
      }

      allow read: if isSuperAdmin()
                  || hasTenantWideProjectAccess(resource.data.tenantId)
                  || brandManagerOwnsProject(resource.data.tenantId, resource.data.projectId);
      allow create: if isSuperAdmin()
                    || (hasTenantWideProjectAccess(request.resource.data.tenantId) && validNewPlan())
                    || (brandManagerOwnsProject(request.resource.data.tenantId, request.resource.data.projectId) && validNewPlan());
      allow update: if isSuperAdmin()
                    || (hasTenantWideProjectAccess(resource.data.tenantId) && validPlanUpdate())
                    || (brandManagerOwnsProject(resource.data.tenantId, resource.data.projectId) && validPlanUpdate());
      allow delete: if isSuperAdmin()
                    || hasTenantWideProjectAccess(resource.data.tenantId)
                    || (brandManagerOwnsProject(resource.data.tenantId, resource.data.projectId) && resource.data.status == 'draft');

      // Onay geçmişi — değiştirilemez; yalnızca sunucu yazar
      match /approval_events/{eventId} {
        function parentPlan() {
          return get(/databases/$(database)/documents/content_plans/$(planId)).data;
        }
        allow read: if isSuperAdmin()
                    || hasTenantWideProjectAccess(parentPlan().tenantId)
                    || brandManagerOwnsProject(parentPlan().tenantId, parentPlan().projectId);
        allow create, update, delete: if false;
      }
    }

    // =============================================
    // Operational / Production Briefs
    // Filled after strategy + contract; mirrors content_plans share-token model
    // =============================================
    match /operational_briefs/{briefId} {
      allow read: if isSuperAdmin()
                  || belongsToTenant()
                  || resource.data.shareToken != null; // public client fill via token
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update: if isSuperAdmin()
                    || belongsToTenant()
                      || resource.data.shareToken != null; // client fills via share token
      allow delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Notifications — users can only read their own
    // =============================================
    match /notifications/{notificationId} {
      allow read: if isSuperAdmin()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update: if isSuperAdmin()
                    || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Filing system
    // =============================================
    match /filing_templates/{templateId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    match /filing_projects/{projectId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Filing counters — auto-increment proje numarası
    // Document ID = tenantId
    // =============================================
    match /filing_counters/{tenantId} {
      allow read: if isSuperAdmin() || (isInternal() && getUserTenantId() == tenantId);
      allow write: if isSuperAdmin() || (isInternal() && getUserTenantId() == tenantId);
    }

    // =============================================
    // Filing config — tenant-level dosyalama ayarları (app seeds vb.)
    // Document ID = tenantId
    // =============================================
    match /filing_config/{tenantId} {
      allow read: if isSuperAdmin() || (isInternal() && getUserTenantId() == tenantId);
      allow write: if isSuperAdmin() || (isInternal() && getUserTenantId() == tenantId);
    }

    // =============================================
    // Marketing AI agent sessions
    // =============================================
    match /marketing_agent_sessions/{sessionId} {
      allow read, write: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
    }

    // =============================================
    // Marketing Plans (AI-generated plans)
    // =============================================
    match /marketing_plans/{planId} {
      allow read, write: if isSuperAdmin() || (belongsToTenant() && isAuthenticated());
      allow create: if isSuperAdmin() || (creatingForOwnTenant() && isAuthenticated());
    }

    // =============================================
    // Workflow instances and templates
    // =============================================
    match /workflow_instances/{instanceId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();

      // Subcollections: append-only for tenant members
      match /audit_log/{entryId} {
        allow read: if isSuperAdmin() || belongsToTenant();
        allow create: if isSuperAdmin() || belongsToTenant();
        allow update, delete: if false;
      }
      match /ai_outputs/{outputId} {
        allow read: if isSuperAdmin() || belongsToTenant();
        allow create: if isSuperAdmin() || belongsToTenant();
        allow update, delete: if false;
      }
    }

    match /workflow_templates/{templateId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // AI Agent Registry
    // =============================================
    match /ai_agents/{agentId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Quotes — fiyat teklifleri (quotes collection)
    // admin + account_manager erişimi
    // =============================================
    match /quotes/{quoteId} {
      // Quotes may not have tenantId (CostEngine), use role-based auth
      allow read: if isSuperAdmin() || (isAuthenticated() && canViewPricing());
      allow create: if isSuperAdmin() || (isAuthenticated() && canViewPricing());
      allow update, delete: if isSuperAdmin() || (isAuthenticated() && canViewPricing());
    }

    // =============================================
    // Settings — uygulama ayarları (settings/financials vb.)
    // admin + account_manager okuyabilir, admin yazabilir
    // =============================================
    match /settings/{docId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && canViewPricing());
      allow write: if isSuperAdmin() || (isAuthenticated() && canViewCost());
    }

    // =============================================
    // Training — eğitim kaynakları ve tamamlamalar
    // =============================================
    match /training_resources/{resourceId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || (belongsToTenant() && isAdmin());
    }

    match /training_completions/{completionId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || isAuthenticated();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Workflow design sessions
    // =============================================
    match /workflow_design_sessions/{sessionId} {
      allow read, write: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
    }

    // =============================================
    // Tasks — standalone görev yönetimi
    // Tenant members can read/write tasks assigned to them or created by them
    // =============================================
    match /tasks/{taskId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Recurring Tasks — periyodik görev şablonları
    // Cron (Admin SDK) bunları okuyup `tasks` koleksiyonuna görev üretir
    // =============================================
    match /recurring_tasks/{templateId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Agency SOPs — ajansın iş kalıpları (Video Çekimi, Sosyal Medya vs.)
    // Tenant üyeleri okuyabilir / yazabilir
    // =============================================
    match /agency_sops/{sopId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Priority Signals — kullanıcının drag-drop ile verdiği tercih sinyalleri
    // AI öğrenme için: hangi tip görevlere öncelik verildiğini tanımak için
    // =============================================
    match /priority_signals/{signalId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin();   // immutable log
    }

    // =============================================
    // Task Intake Sessions — AI görev sohbet oturumları
    // Only the creator can read/write their own session
    // =============================================
    match /task_intake_sessions/{sessionId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update: if isSuperAdmin() || belongsToTenant();
      allow delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Agent Memories — persistent AI agent context
    // Tenant members can read/write their own tenant's memories
    // =============================================
    match /agent_memories/{memoryId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      allow update, delete: if isSuperAdmin() || belongsToTenant();
    }

    // =============================================
    // Audit Trail — tamper-evident hash chain logs
    // Read-only for tenant members, append-only (no update/delete)
    // =============================================
    match /audit_trail/{entryId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || creatingForOwnTenant();
      // No update or delete — audit trail is immutable
    }

    // =============================================
    // Role Configs — dynamic RBAC per tenant
    // =============================================
    match /role_configs/{tenantId} {
      allow read: if isAuthenticated() && getUserTenantId() == tenantId;
      allow write: if isAdmin() && getUserTenantId() == tenantId;
    }

    // =============================================
    // Drive Upload Sessions — per-user resumable uploads
    // =============================================
    match /drive_upload_sessions/{sessionId} {
      allow read: if isAuthenticated()
                  && resource.data.tenantId == getUserTenantId()
                  && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
                    && request.resource.data.tenantId == getUserTenantId()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
                    && resource.data.tenantId == getUserTenantId()
                    && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
                    && resource.data.tenantId == getUserTenantId()
                    && resource.data.userId == request.auth.uid;
    }

    // =============================================
    // Rental Catalog (Kiralacek.co) — global, tenant-independent
    // =============================================
    match /rental_catalog/{itemId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isAuthenticated() && getUserRole() == 'admin');
    }

    // Background Agents — persistent autonomous agents
    // Admin-only write, tenant-level read
    // =============================================
    match /background_agents/{agentId} {
      allow read: if isSuperAdmin() || belongsToTenant();
      allow create: if isSuperAdmin() || (isAdmin() && creatingForOwnTenant());
      allow update, delete: if isSuperAdmin() || (isAdmin() && belongsToTenant());

      // Execution history subcollection
      match /executions/{executionId} {
        allow read: if isSuperAdmin()
                    || (isInternal()
                        && get(/databases/$(database)/documents/background_agents/$(agentId)).data.tenantId == getUserTenantId());
        allow create: if isSuperAdmin()
                      || (isInternal()
                          && get(/databases/$(database)/documents/background_agents/$(agentId)).data.tenantId == getUserTenantId());
      }
    }
  }
}
