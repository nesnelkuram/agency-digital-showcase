rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Brand leads: allow public creation from website wizard
    match /brand_leads/{leadId} {
      // Anyone can create a new lead (website form)
      allow create: if true;
      // Only authenticated users can read, update, delete (admin panel)
      allow read, update, delete: if request.auth != null;
    }

    // All other collections: authenticated users only
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
