rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =============================================
    // Helper: check authentication
    // =============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // =============================================
    // Tenant-scoped feedback videos
    // Public read (for shared video links), tenant-scoped write
    // Path: /feedback/{tenantId}/{userId}/{allPaths}
    // =============================================
    match /feedback/{tenantId}/{userId}/{allPaths=**} {
      // Public read access for all feedback videos (shared links)
      allow read: if true;
      // Only authenticated owner within their tenant can write
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && request.resource.size < 500 * 1024 * 1024; // max 500MB
    }

    // Legacy feedback path (without tenant) - read-only for backwards compatibility
    match /feedback/{userId}/{allPaths=**} {
      allow read: if true;
      // No new writes allowed on legacy path
    }

    // =============================================
    // Tenant-scoped assets
    // Path: /assets/{tenantId}/{userId}/{allPaths}
    // =============================================
    match /assets/{tenantId}/{userId}/{allPaths=**} {
      // Authenticated users in the same tenant can read
      allow read: if isAuthenticated();
      // Only authenticated owner can write
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024; // max 100MB
    }

    // Legacy assets path (without tenant) - read-only for backwards compatibility
    match /assets/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      // No new writes allowed on legacy path
    }

    // =============================================
    // Tenant-scoped creatives
    // Path: /creatives/{tenantId}/{userId}/{allPaths}
    // =============================================
    match /creatives/{tenantId}/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024; // max 100MB
    }

    // =============================================
    // Tenant-scoped project files
    // Path: /projects/{tenantId}/{allPaths}
    // =============================================
    match /projects/{tenantId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size < 100 * 1024 * 1024; // max 100MB
    }

    // =============================================
    // Tenant-scoped campaign media
    // Path: /campaigns/{tenantId}/{allPaths}
    // =============================================
    match /campaigns/{tenantId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size < 100 * 1024 * 1024; // max 100MB
    }
  }
}
