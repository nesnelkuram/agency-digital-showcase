{
  "framework": "vite",
  "buildCommand": "node scripts/build-blog-kb.mjs && node scripts/build-api.mjs && vite build",
  "functions": {
    "api/export-research/*.ts": {
      "maxDuration": 30,
      "includeFiles": "private-reports/abd-tekne-aksesuarlari.pdf"
    },
    "{api/analyze-start.ts,api/persona/chat.ts,api/agents/generate-agent.ts,api/service-catalog/design-chat.ts,api/tasks/intake-chat.ts,api/workflow/{design-chat,builder-chat}.ts,api/cron/{spawn-recurring-workflows,spawn-recurring-tasks,task-digest,task-reminders,canva-sync}.ts,api/drive/{sync,import}.ts,api/canva/sync.ts}": {
      "maxDuration": 60
    },
    "{api/analyze-continue.ts,api/workflow/execute-step-internal.ts,api/cron/{marketing-optimize,marketing-daily-report,sync-meta-campaigns,media-analysis}.ts,api/marketing/{optimize,generate-campaign,generate-ad-copy,generate-report,ai-optimize}.ts}": {
      "maxDuration": 300
    },
    "{api/transcribe-video.ts,api/workflow/{complete-step,execute-agent}.ts,api/marketing/{sync-campaigns,sync-performance,sync-breakdowns,forecast-budget,analyze-competitor,analyze-campaign,agent-execute-action,agent-chat-v2}.ts,api/studio/plan-copy.ts}": {
      "maxDuration": 120
    },
    "{api/persona/start.ts,api/social-media/{generate-caption,iterate-caption}.ts,api/tasks/{analyze-task,breakdown-task,send-test-digest,score-delegation}.ts,api/workflow/review-output.ts,api/marketing/{approve-action,publish-plan}.ts,api/marketing/platforms/callback.ts,api/telegram/webhook.ts}": {
      "maxDuration": 30
    },
    "api/social-media/client-review-post.ts": {
      "maxDuration": 15
    },
    "{api/telegram/link.ts,api/approve-strategy.ts}": {
      "maxDuration": 10
    },
    "{api/media/analyze.ts,api/studio/plan-suggest.ts}": {
      "maxDuration": 180
    }
  },
  "crons": [
    {
      "path": "/api/cron/marketing-optimize",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/marketing-daily-report",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/spawn-recurring-workflows",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/spawn-recurring-tasks",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-meta-campaigns",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/task-digest",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/task-reminders",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/canva-sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/media-analysis",
      "schedule": "*/30 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/kosebasi/strateji",
      "destination": "/kosebasi/strateji/index.html"
    },
    {
      "source": "/kosebasi/strateji/",
      "destination": "/kosebasi/strateji/index.html"
    },
    {
      "source": "/odagi",
      "destination": "/odagi/index.html"
    },
    {
      "source": "/odagi/",
      "destination": "/odagi/index.html"
    },
    {
      "source": "/ihracat",
      "destination": "/ihracat/index.html"
    },
    {
      "source": "/ihracat/",
      "destination": "/ihracat/index.html"
    },
    {
      "source": "/ihracat/gizlilik",
      "destination": "/ihracat/gizlilik.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/fatura/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|googlebot|bingbot|redditbot|pinterest|applebot|skypeuripreview|vkshare|embedly|quora link preview|outbrain|nuzzel|w3c_validator).*"
        }
      ],
      "destination": "/api/og/invoice"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/ihracat(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' tauri://localhost http://tauri.localhost https://tauri.localhost http://localhost:1420"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/((?!admin).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
