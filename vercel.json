{
  "framework": "vite",
  "buildCommand": "node scripts/build-blog-kb.mjs && node scripts/build-api.mjs && vite build",
  "functions": {
    "api/studio/plan-creative.ts": {
      "maxDuration": 120
    },
    "api/export-research/*.ts": {
      "maxDuration": 30,
      "includeFiles": "private-reports/abd-tekne-aksesuarlari.pdf"
    },
    "{api/agents/generate-agent.ts,api/analyze-start.ts,api/canva/sync.ts,api/cron/{canva-sync,spawn-recurring-tasks,spawn-recurring-workflows,task-digest,task-reminders}.ts,api/drive/{import,sync}.ts,api/persona/chat.ts}": {
      "maxDuration": 60
    },
    "{api/service-catalog/design-chat.ts,api/tasks/intake-chat.ts,api/workflow/{builder-chat,design-chat}.ts}": {
      "maxDuration": 60
    },
    "{api/analyze-continue.ts,api/cron/{marketing-daily-report,marketing-optimize,media-analysis,sync-meta-campaigns}.ts,api/marketing/{ai-optimize,generate-ad-copy,generate-campaign,generate-report,optimize}.ts}": {
      "maxDuration": 300
    },
    "api/workflow/execute-step-internal.ts": {
      "maxDuration": 300
    },
    "{api/marketing/{agent-chat-v2,agent-execute-action,analyze-campaign,analyze-competitor,forecast-budget,sync-breakdowns,sync-campaigns,sync-performance}.ts,api/studio/{brand-guide,plan-copy}.ts,api/transcribe-video.ts,api/workflow/complete-step.ts}": {
      "maxDuration": 120
    },
    "api/workflow/execute-agent.ts": {
      "maxDuration": 120
    },
    "{api/marketing/{approve-action,publish-plan}.ts,api/marketing/platforms/callback.ts,api/persona/start.ts,api/social-media/{generate-caption,iterate-caption}.ts,api/tasks/{analyze-task,breakdown-task,score-delegation,send-test-digest}.ts}": {
      "maxDuration": 30
    },
    "{api/telegram/webhook.ts,api/workflow/review-output.ts}": {
      "maxDuration": 30
    },
    "api/social-media/client-review-post.ts": {
      "maxDuration": 15
    },
    "{api/approve-strategy.ts,api/telegram/link.ts}": {
      "maxDuration": 10
    },
    "{api/media/analyze.ts,api/studio/plan-suggest.ts}": {
      "maxDuration": 180
    }
  },
  "crons": [
    {
      "path": "/api/cron/marketing-optimize",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/marketing-daily-report",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/spawn-recurring-workflows",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/spawn-recurring-tasks",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-meta-campaigns",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/task-digest",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/task-reminders",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/canva-sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/media-analysis",
      "schedule": "*/30 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/kosebasi/strateji",
      "destination": "/kosebasi/strateji/index.html"
    },
    {
      "source": "/kosebasi/strateji/",
      "destination": "/kosebasi/strateji/index.html"
    },
    {
      "source": "/odagi",
      "destination": "/odagi/index.html"
    },
    {
      "source": "/odagi/",
      "destination": "/odagi/index.html"
    },
    {
      "source": "/ihracat",
      "destination": "/ihracat/index.html"
    },
    {
      "source": "/ihracat/",
      "destination": "/ihracat/index.html"
    },
    {
      "source": "/ihracat/gizlilik",
      "destination": "/ihracat/gizlilik.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/fatura/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|googlebot|bingbot|redditbot|pinterest|applebot|skypeuripreview|vkshare|embedly|quora link preview|outbrain|nuzzel|w3c_validator).*"
        }
      ],
      "destination": "/api/og/invoice"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/ihracat(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' tauri://localhost http://tauri.localhost https://tauri.localhost http://localhost:1420"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/((?!admin).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
