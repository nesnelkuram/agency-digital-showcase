    "api/marketing/generate-ad-copy.ts": {
      "maxDuration": 300,
      "excludeFiles": "api/_bundles/**"
    },
    "api/marketing/generate-report.ts": {
      "maxDuration": 300,
      "excludeFiles": "api/_bundles/**"
    },
    "api/marketing/forecast-budget.ts": {
      "maxDuration": 120,
      "excludeFiles": "api/_bundles/**"
    },
    "api/marketing/analyze-competitor.ts": {
      "maxDuration": 120,
      "excludeFiles": "api/_bundles/**"
    },
    "api/marketing/analyze-campaign.ts": {
      "maxDuration": 120,
      "excludeFiles": "api/_bundles/**"
    },
    "api/marketing/ai-optimize.ts": {
      "maxDuration": 300,
      "excludeFiles": "api/_bundles/**"
    },
    "api/marketing/platforms/connect.ts": {
      "maxDuration": 10,
      "excludeFiles": "api/_bundles/**"
    },
    "api/marketing/platforms/callback.ts": {
      "maxDuration": 30,
      "excludeFiles": "api/_bundles/**"
    },
    "api/marketing/agent-start.ts": {
      "maxDuration": 10,
      "excludeFiles": "api/_bundles/**"
    },
    "api/marketing/agent-execute-action.ts": {
      "maxDuration": 120,
      "includeFiles": "api/_lib/{withAuth,firebaseAdmin,rateLimit,env}.{ts,js}",
