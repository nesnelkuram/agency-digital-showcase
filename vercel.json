{
  "framework": "vite",
  "buildCommand": "node scripts/build-blog-kb.mjs && node scripts/build-api.mjs && vite build",
  "functions": {
    "api/analyze-start.ts": { "maxDuration": 60 },
    "api/analyze-continue.ts": { "maxDuration": 300 },
    "api/transcribe-video.ts": { "maxDuration": 120 },
    "api/persona/chat.ts": { "maxDuration": 60 },
    "api/persona/start.ts": { "maxDuration": 30 },
    "api/agents/generate-agent.ts": { "maxDuration": 60 },
    "api/service-catalog/design-chat.ts": { "maxDuration": 60 },
    "api/social-media/generate-caption.ts": { "maxDuration": 30 },
    "api/social-media/iterate-caption.ts": { "maxDuration": 30 },
    "api/social-media/client-review-post.ts": { "maxDuration": 15 },
    "api/tasks/analyze-task.ts": { "maxDuration": 30 },
    "api/tasks/breakdown-task.ts": { "maxDuration": 30 },
    "api/tasks/send-test-digest.ts": { "maxDuration": 30 },
    "api/tasks/intake-chat.ts": { "maxDuration": 60 },
    "api/workflow/design-chat.ts": { "maxDuration": 60 },
    "api/workflow/builder-chat.ts": { "maxDuration": 60 },
    "api/workflow/complete-step.ts": { "maxDuration": 120 },
    "api/workflow/execute-step-internal.ts": { "maxDuration": 300 },
    "api/workflow/execute-agent.ts": { "maxDuration": 120 },
    "api/workflow/review-output.ts": { "maxDuration": 30 },
    "api/cron/marketing-optimize.ts": { "maxDuration": 300 },
    "api/cron/marketing-daily-report.ts": { "maxDuration": 300 },
    "api/marketing/approve-action.ts": { "maxDuration": 30 },
    "api/cron/spawn-recurring-workflows.ts": { "maxDuration": 60 },
    "api/cron/spawn-recurring-tasks.ts": { "maxDuration": 60 },
    "api/cron/sync-meta-campaigns.ts": { "maxDuration": 300 },
    "api/marketing/sync-campaigns.ts": { "maxDuration": 120 },
    "api/marketing/sync-performance.ts": { "maxDuration": 120 },
    "api/marketing/sync-breakdowns.ts": { "maxDuration": 120 },
    "api/marketing/optimize.ts": { "maxDuration": 300 },
    "api/marketing/generate-campaign.ts": { "maxDuration": 300 },
    "api/marketing/generate-ad-copy.ts": { "maxDuration": 300 },
    "api/marketing/generate-report.ts": { "maxDuration": 300 },
    "api/marketing/forecast-budget.ts": { "maxDuration": 120 },
    "api/marketing/analyze-competitor.ts": { "maxDuration": 120 },
    "api/marketing/analyze-campaign.ts": { "maxDuration": 120 },
    "api/marketing/ai-optimize.ts": { "maxDuration": 300 },
    "api/marketing/platforms/callback.ts": { "maxDuration": 30 },
    "api/marketing/agent-execute-action.ts": { "maxDuration": 120 },
    "api/marketing/agent-chat-v2.ts": { "maxDuration": 120 },
    "api/marketing/publish-plan.ts": { "maxDuration": 30 },
    "api/telegram/webhook.ts": { "maxDuration": 30 },
    "api/telegram/link.ts": { "maxDuration": 10 },
    "api/cron/task-digest.ts": { "maxDuration": 60 },
    "api/cron/task-reminders.ts": { "maxDuration": 60 },
    "api/tasks/score-delegation.ts": { "maxDuration": 30 },
    "api/approve-strategy.ts": { "maxDuration": 10 },
    "api/drive/sync.ts": { "maxDuration": 60 },
    "api/drive/import.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/marketing-optimize",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/marketing-daily-report",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/spawn-recurring-workflows",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/spawn-recurring-tasks",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-meta-campaigns",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/task-digest",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/task-reminders",
      "schedule": "*/30 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' tauri://localhost http://tauri.localhost https://tauri.localhost http://localhost:1420"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/((?!admin).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
