{
  "framework": "vite",
  "functions": {
    "api/analyze-brand-multi.ts": {
      "includeFiles": "src/pipeline/**"
    },
    "api/analyze-start.ts": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/**"
    },
    "api/analyze-continue.ts": {
      "maxDuration": 300,
      "includeFiles": "api/_lib/**"
    },
    "api/transcribe-video.ts": {
      "maxDuration": 120
    },
    "api/marketing/generate-proposal.ts": {
      "maxDuration": 300
    },
    "api/marketing/approve-proposal.ts": {
      "maxDuration": 60
    },
    "api/marketing/execute-campaign.ts": {
      "maxDuration": 120
    },
    "api/marketing/sync-campaigns.ts": {
      "maxDuration": 120
    },
    "api/marketing/sync-performance.ts": {
      "maxDuration": 120
    },
    "api/marketing/optimize.ts": {
      "maxDuration": 300
    },
    "api/marketing/generate-campaign.ts": {
      "maxDuration": 300
    },
    "api/marketing/generate-ad-copy.ts": {
      "maxDuration": 300
    },
    "api/marketing/platforms/connect.ts": {
      "maxDuration": 10
    },
    "api/marketing/platforms/callback.ts": {
      "maxDuration": 30
    },
    "api/marketing/forecast-budget.ts": {
      "maxDuration": 120
    },
    "api/marketing/sync-google.ts": {
      "maxDuration": 120
    },
    "api/marketing/sync-tiktok.ts": {
      "maxDuration": 120
    },
    "api/marketing/sync-linkedin.ts": {
      "maxDuration": 120
    },
    "api/marketing/generate-report.ts": {
      "maxDuration": 300
    },
    "api/marketing/analyze-competitor.ts": {
      "maxDuration": 120
    },
    "api/marketing/sync-breakdowns.ts": {
      "maxDuration": 120
    },
    "api/marketing/analyze-campaign.ts": {
      "maxDuration": 120
    },
    "api/marketing/ai-optimize.ts": {
      "maxDuration": 300
    },
    "api/cron/marketing-optimize.ts": {
      "maxDuration": 300
    },
    "api/workflow/design-start.ts": {
      "maxDuration": 10,
      "includeFiles": "api/_lib/**"
    },
    "api/workflow/design-chat.ts": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/**"
    },
    "api/service-catalog/design-start.ts": {
      "maxDuration": 10,
      "includeFiles": "api/_lib/**"
    },
    "api/service-catalog/design-chat.ts": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/**"
    },
    "api/social-media/generate-caption.ts": {
      "maxDuration": 30,
      "includeFiles": "api/_lib/**"
    },
    "api/marketing/agent-start.ts": {
      "maxDuration": 10
    },
    "api/marketing/agent-chat.ts": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/**"
    },
    "api/marketing/agent-execute-action.ts": {
      "maxDuration": 120,
      "includeFiles": "api/_lib/**"
    },
    "api/invite-user.ts": {
      "maxDuration": 10,
      "includeFiles": "api/_lib/**"
    },
    "api/marketing/agent-chat-v2.ts": {
      "maxDuration": 120,
      "includeFiles": "api/_lib/**"
    },
    "api/agents/generate-agent.ts": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/**"
    },
    "api/workflow/complete-step.ts": {
      "maxDuration": 120,
      "includeFiles": "api/_lib/**"
    },
    "api/workflow/execute-step-internal.ts": {
      "maxDuration": 300,
      "includeFiles": "src/pipeline/**"
    },
    "api/cron/spawn-recurring-workflows.ts": {
      "maxDuration": 60
    },
    "api/tasks/analyze-task.ts": {
      "maxDuration": 30,
      "includeFiles": "api/_lib/**"
    },
    "api/tasks/create-intake-session.ts": {
      "maxDuration": 10,
      "includeFiles": "api/_lib/**"
    },
    "api/tasks/intake-chat.ts": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/**"
    },
    "api/tasks/update-task.ts": {
      "maxDuration": 10,
      "includeFiles": "api/_lib/**"
    },
    "api/cron/sync-meta-campaigns.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/marketing-optimize",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/spawn-recurring-workflows",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-meta-campaigns",
      "schedule": "0 */6 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
