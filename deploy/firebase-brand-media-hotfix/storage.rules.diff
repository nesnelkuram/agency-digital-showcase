+    // Marka medya kütüphanesi: tenant genelindeki iç roller (freelancer HARİÇ) + atanmış brand_manager.
+    // Proje Firestore'da var ve aynı tenant'a ait olmalı (istek başına ≤2 doküman: kullanıcı + proje).
+    function canUseBrandLibrary(tenantId, projectId) {
+      return isAuthenticated()
+        && userDoc().tenantId == tenantId
+        && (userDoc().role in ['super_admin', 'admin', 'account_manager', 'staff', 'editor']
+            || (userDoc().role == 'brand_manager'
+                && projectId in userDoc().get('profile', {}).get('assignedProjectIds', [])))
+        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.tenantId == tenantId;
+    }
