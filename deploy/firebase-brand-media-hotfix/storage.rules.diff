+    // =============================================
+    // Marka medya kütüphanesi — paylaşılmaya hazır FINAL fotoğraf/video (docs/studio-media-library.md)
+    // Okuma/listeleme ve yazma: canUseBrandLibrary. Müşteri ve anonim erişemez; müşteri medyayı yalnız
+    // kendisine açılmış post'taki token'lı URL ile görür (paylaşım/portal API'si).
+    // Yazma bir kez (write-once); üzerine yazma ve istemciden silme yok.
+    // Panel yükleme sınırı: 1 GB = 1000000000 bayt (shared/types/brandMedia.ts LIBRARY_MAX_FILE_BYTES).
+    // Önizleme: aynı klasörde thumb.jpg, image/jpeg, ≤ 2000000 bayt.
+    // Path: /brand-media/{tenantId}/{projectId}/{assetId}/{fileName}
+    // =============================================
+    match /brand-media/{tenantId}/{projectId}/{assetId}/{fileName} {
+      allow get, list: if canUseBrandLibrary(tenantId, projectId);
+      allow create: if resource == null
+                    && canUseBrandLibrary(tenantId, projectId)
+                    && ((fileName == 'thumb.jpg'
+                         && request.resource.contentType == 'image/jpeg'
+                         && request.resource.size <= 2000000)
+                        || (fileName != 'thumb.jpg'
+                            && request.resource.size <= 1000000000
+                            && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'))));
+      allow update, delete: if false;
+    }
+
