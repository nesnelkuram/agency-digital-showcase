[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "PUT", "POST", "DELETE"],
    "maxAgeSeconds": 3600,
    "responseHeader": [
      "Content-Type",
      "Content-Length",
      "Content-Range",
      "Authorization",
      "X-Requested-With",
      "x-goog-resumable",
      "x-goog-upload-url",
      "x-goog-upload-status",
      "x-goog-upload-command",
      "x-goog-upload-offset",
      "x-goog-upload-size-received",
      "x-firebase-storage-version"
    ]
  }
]
